# ── Cloud Deployment Environment Variables ──
# Copy this file to .env and adjust values for your deployment.

# ── Database (external PostgreSQL, e.g. Aiven, Render, Supabase) ──
# Paste the full connection URI from your provider.

# ── Backend ──
DATABASE_URL=postgres://user:password@host:port/dbname?sslmode=require
JWT_SECRET=change-me-in-production
# Access token lifetime is fixed at 15 minutes.
# Refresh token lifetime is fixed at 7 days in the database.
# Same-site frontend/API subdomains should use Lax cookies.
AUTH_COOKIE_SAME_SITE=lax
# AUTH_COOKIE_SECURE=true
PORT=3001
NODE_ENV=production
FRONTEND_URL=https://mymementomori.com,https://www.mymementomori.com,https://memento-mori-fe.onrender.com
GOOGLE_REDIRECT_URI=https://api.mymementomori.com/api/auth/google/callback
UPLOAD_DIR=./uploads

# Cloudflare R2 (required for image storage)
R2_ACCOUNT_ID=
R2_ENDPOINT=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_SIGNED_URL_TTL_SECONDS=3600

# ── Frontend ──
# Static frontend + separate backend service should point at the API subdomain.
VITE_API_URL=https://api.mymementomori.com

# Base path for the frontend app (default: /).
# Set to /memento-mori/ for GitHub Pages deployment.
# VITE_BASE_PATH=/
