# ── Cloud Deployment Environment Variables ──
# Copy this file to .env and adjust values for your deployment.

# ── Database (external PostgreSQL, e.g. Aiven, Render, Supabase) ──
# Paste the full connection URI from your provider.

# ── Backend ──
DATABASE_URL=postgres://user:password@host:port/dbname?sslmode=require
JWT_SECRET=change-me-in-production
JWT_REFRESH_SECRET=change-me-too-in-production
# Access token lifetime is fixed at 15 minutes.
# Refresh token lifetime is fixed at 7 days.
# Prefer a same-site frontend/API deployment for cookie auth when possible.
AUTH_COOKIE_SAME_SITE=none
# AUTH_COOKIE_DOMAIN=.mymementomori.com
# AUTH_COOKIE_SECURE=true
PORT=3001
NODE_ENV=production
FRONTEND_URL=https://mymementomori.com,https://www.mymementomori.com,https://memento-mori-fe.onrender.com
UPLOAD_DIR=./uploads

# Cloudflare R2 (required for image storage)
R2_ACCOUNT_ID=
R2_ENDPOINT=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_SIGNED_URL_TTL_SECONDS=3600

# ── Frontend ──
# Leave empty to use relative paths (same-origin via nginx proxy).
# Set to a full URL if backend is on a different domain.
# VITE_API_URL=

# Base path for the frontend app (default: /).
# Set to /memento-mori/ for GitHub Pages deployment.
# VITE_BASE_PATH=/
