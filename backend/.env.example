# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/memento_mori?schema=public

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
# Access token lifetime is fixed at 15 minutes.
# Refresh token lifetime is fixed at 7 days in the database.
# Same-site frontend/API subdomains can use Lax cookies
# (for example: mymementomori.com + api.mymementomori.com).
# If the frontend calls a different-site backend such as *.onrender.com,
# use AUTH_COOKIE_SAME_SITE=none and AUTH_COOKIE_SECURE=true instead.
AUTH_COOKIE_SAME_SITE=lax
# AUTH_COOKIE_SECURE=true

# Server
PORT=3001
NODE_ENV=development

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173,https://mymementomori.com,https://www.mymementomori.com
FRONTEND_APP_URL=http://localhost:5173

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3001/api/auth/google/callback

# File uploads
UPLOAD_DIR=./uploads

# Contact / Email (Gmail SMTP)
CONTACT_EMAIL=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=your-gmail-app-password-here

# Cloudflare R2 (required for image storage)
R2_ACCOUNT_ID=
R2_ENDPOINT=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_SIGNED_URL_TTL_SECONDS=3600
