# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/memento_mori?schema=public

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
# Access token lifetime is fixed at 15 minutes.
# Refresh token lifetime is fixed at 7 days in the database.
# Same-site frontend/API subdomains can use Lax cookies
# (for example: mymementomori.com + api.mymementomori.com).
# If the frontend calls a different-site backend such as *.onrender.com,
# use AUTH_COOKIE_SAME_SITE=none and AUTH_COOKIE_SECURE=true instead.
AUTH_COOKIE_SAME_SITE=lax
# AUTH_COOKIE_SECURE=true

# Server
PORT=3001
NODE_ENV=development

# Frontend URL (for CORS — comma-separated allowlist of origins)
FRONTEND_URL=http://localhost:5173,https://mymementomori.com,https://www.mymementomori.com
# Frontend app URL (used to build links in emails and OAuth redirects).
# Must be the base URL users see in their browser — include any base path
# (e.g. /memento-mori/) if the frontend is served from a subdirectory.
# In production, this MUST be set to the real frontend origin or the app
# will refuse to start (the localhost default is rejected in production).
FRONTEND_APP_URL=http://localhost:5173

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3001/api/auth/google/callback

# Email verification (Resend)
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@mymementomori.com
EMAIL_VERIFICATION_TTL_HOURS=24
UNVERIFIED_ACCOUNT_TTL_DAYS=7
UNVERIFIED_ACCOUNT_CLEANUP_CRON=0 2 * * *

# Password reset
PASSWORD_RESET_TTL_MINUTES=60
FORGOT_PASSWORD_RATE_LIMIT_MAX=5
FORGOT_PASSWORD_RATE_LIMIT_WINDOW_MINUTES=60

# File uploads
UPLOAD_DIR=./uploads

# Contact form recipient
CONTACT_EMAIL=
CONTACT_RECIPIENT_EMAIL=dennisvoutos@gmail.com

# Cloudflare R2 (required for image storage)
R2_ACCOUNT_ID=
R2_ENDPOINT=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_SIGNED_URL_TTL_SECONDS=3600

# Apple Sign-In (required for Sign in with Apple)
# Obtain these from the Apple Developer Portal → Certificates, Identifiers & Profiles
# 1. Register a Services ID for Sign in with Apple
# 2. Create a private key for Sign in with Apple
# 3. Note your Team ID (found in Membership details)
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
# Paste the full PEM private key including -----BEGIN PRIVATE KEY----- and -----END PRIVATE KEY-----
# Replace literal newlines with \n in the .env value
APPLE_PRIVATE_KEY=
# The redirect URI must match what's registered in your Apple Services ID
# For local dev: http://localhost:3001/api/auth/apple/callback
# For production: https://api.mymementomori.com/api/auth/apple/callback
APPLE_REDIRECT_URI=http://localhost:3001/api/auth/apple/callback

# Google Photos Integration
# Uses the same GOOGLE_CLIENT_ID and GOOGLE_CLIENT_SECRET as Google Sign-In.
# The Google Cloud project must have the Photos Library API enabled.

# Scopes requested during the Photos incremental OAuth flow (space-separated).
# These must match what's enabled in your Google Cloud Console OAuth consent screen.
# Defaults to: openid https://www.googleapis.com/auth/userinfo.email
#   https://www.googleapis.com/auth/userinfo.profile
#   https://www.googleapis.com/auth/photoslibrary.readonly
#   https://www.googleapis.com/auth/photoslibrary.readonly.originals
#   https://www.googleapis.com/auth/photospicker.mediaitems.readonly
# Uncomment and expand if you added more scopes in Google Cloud Console:
# GOOGLE_PHOTOS_SCOPES=https://www.googleapis.com/auth/userinfo.email https://www.googleapis.com/auth/userinfo.profile https://www.googleapis.com/auth/photoslibrary.readonly https://www.googleapis.com/auth/photoslibrary.readonly.originals https://www.googleapis.com/auth/photospicker.mediaitems.readonly https://www.googleapis.com/auth/photoslibrary https://www.googleapis.com/auth/photoslibrary.appendonly https://www.googleapis.com/auth/photoslibrary.sharing

# Redirect URI for the Google Photos OAuth callback.
# Must match one of the Authorized redirect URIs in your Google Cloud Console.
# Defaults to GOOGLE_REDIRECT_URI (for local dev: http://localhost:3001/api/auth/google/photos/callback).
# For production, register https://api.mymementomori.com/api/auth/google/photos/callback
# in Google Cloud Console and set this:
# GOOGLE_PHOTOS_REDIRECT_URI=https://api.mymementomori.com/api/auth/google/photos/callback
